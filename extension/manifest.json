{
  "manifest_version": 3,
  "name": "Preparar planilla de MercadoLibre",
  "version": "0.2.0",
  "description": "Prepara, descarga y programa automáticamente la planilla de publicaciones de MercadoLibre Venezuela.",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://vendedores.mercadolibre.com.ve/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://vendedores.mercadolibre.com.ve/publicaciones/edicion-en-excel*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Programación de descargas",
    "default_popup": "options.html"
  },
  "icons": {
    "128": "icon.png"
  }
}