{
  "manifest_version": 3,
  "name": "Valery Code Finder",
  "version": "1.0.2",
  "description": "Copia el código de Valery asociado a publicaciones de MercadoLibre.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://vendedores.mercadolibre.com.ve/publicaciones*",
    "https://articulo.mercadolibre.com.ve/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["valery-logo.svg"],
      "matches": [
        "https://vendedores.mercadolibre.com.ve/*",
        "https://articulo.mercadolibre.com.ve/*"
      ]
    }
  ],
  "action": {
    "default_title": "Valery Code Finder",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vendedores.mercadolibre.com.ve/publicaciones*",
        "https://articulo.mercadolibre.com.ve/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}